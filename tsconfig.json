{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "alacritty/**/*.ts",
    "chrome/**/*.ts",
    "vscode/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
  ]
}