{
  "name": "ohohama",
  "displayName": "Ohohama Color Theme",
  "description": "Ohohama blue color theme",
  "icon": "images/icon.png",
  "version": "0.3.10",
  "publisher": "ieremius",
  "type": "module",
  "scripts": {
    "build": "npm run build:vscode && npm run build:alacritty",
    "build:vscode": "tsx vscode/build.ts",
    "build:alacritty": "tsx alacritty/build.ts",
    "build:chrome": "tsx chrome/build.ts",
    "check-palette": "tsx scripts/check-palette.ts",
    "coverage": "tsx scripts/coverage.ts",
    "generate:theme-colors": "tsx scripts/generate-theme-colors.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "missing": "tsx scripts/missing.ts",
    "package": "npm run build && vsce package",
    "typecheck": "tsc --noEmit",
    "watch": "concurrently \"npm:watch:vscode\" \"npm:watch:alacritty\" \"npm:watch:chrome\"",
    "watch:vscode": "tsx --watch scripts/build.ts",
    "watch:alacritty": "tsx --watch alacritty/build.ts",
    "watch:chrome": "tsx --watch chrome/build.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ieremi/ohohama"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Ohohama",
        "uiTheme": "vs-dark",
        "path": "./vscode/themes/Ohohama-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.1.2",
    "@vscode/vsce": "^3.0.0",
    "color-convert": "^3.1.3",
    "concurrently": "^10.0.4",
    "culori": "^4.0.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.5",
    "smol-toml": "^1.7.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}